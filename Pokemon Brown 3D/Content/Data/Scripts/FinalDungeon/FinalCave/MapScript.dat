version=2
:if:<Register.Registered(PhanceroShiny)>=false
	:if:<system.random(0,<Pokemon.MasterShinyRate>)>=0
		@Register.Register(PhanceroShiny,bool,true)
	:else
		@Register.Register(PhanceroShiny,bool,false)
	:endif
:endif
:if:<Register.Registered(SeenPhancero)>=false
	:if:<Register.Value(PhanceroShiny)>=true
		@npc.spawn(9,0,2,1,FinalDungeon\FinalCave\Phancero,[POKEMON|S]1010,1,2,Phancero,1,Still)
	:else
		@npc.spawn(9,0,2,1,FinalDungeon\FinalCave\Phancero,[POKEMON|N]1010,1,2,Phancero,1,Still)
	:endif
	
:else
	@entity.remove(0)
	:if:<Register.Registered(HasNotGivenFeatherYet)>=true
		@Text.Show(<system.token(FinalDungeon_FinalCave_Feather_1)>)
		@Sound.Play(Receive_Item,1)
		@Text.Color(Player)
		@Text.Show(<system.token(FinalDungeon_FinalCave_Feather_2)>)
		@Text.Color(Default)
		@Text.Show(<system.token(FinalDungeon_FinalCave_Feather_3)>)
		@Item.Give(gm95,1)
		
		@Register.Unregister(HasNotGivenFeatherYet)
	:endif
:endif

:end
