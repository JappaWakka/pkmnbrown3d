version=2

:if:<Register.Registered(StephaniePokemonSwap)>=false <and> <player.badges>=0 <and> <Register.Registered(StephanieShinyCalculation)>=false
	:if:<Register.Registered(Shiny_StephanieSwap_MetalBall)>=false
		:if:<system.random(0,<math.floor(<pokemon.mastershinyrate>)>)>=0
			@Register.Register(Shiny_StephanieSwap_MetalBall,integer,1)
		:else
			@Register.Register(Shiny_StephanieSwap_MetalBall,integer,0)
		:endif
	:endif
	:if:<Register.Registered(Shiny_StephanieSwap_NormalBall)>=false
		:if:<system.random(0,<math.floor(<pokemon.mastershinyrate>)>)>=0
			@Register.Register(Shiny_StephanieSwap_NormalBall,integer,1)
		:else
			@Register.Register(Shiny_StephanieSwap_NormalBall,integer,0)
		:endif
	:endif
	:if:<Register.Registered(Shiny_StephanieSwap_MysteryBall)>=false
		:if:<system.random(0,<math.floor(<pokemon.mastershinyrate>)>)>=0
			@Register.Register(Shiny_StephanieSwap_MysteryBall,integer,1)
		:else
			@Register.Register(Shiny_StephanieSwap_MysteryBall,integer,0)
		:endif
	:endif
	@Register.Register(StephanieShinyCalculation)

	:if:<Register.Registered(StarterLevelAfterFirstBattle)>=true
		@Storage.Set(bool,CheckForStarter,false)
		@Storage.Set(int,PartyIndex,0)
		:while:<storage.get(bool,CheckForStarter)>=false
			:if:<System.Contains(1;2;3;4;5;6;7;8;9,<Pokemon.Number(0)>)>
					@Storage.Set(bool,CheckForStarter,true)
			:else
				:if:<storage.get(int,PartyIndex)><<Pokemon.Count>-1
					@Storage.Set(int,PartyIndex,<storage.get(int,PartyIndex)>+1)
				:else
					@Storage.Set(int,PartyIndex,-1)
					@Storage.Set(bool,CheckForStarter,true)
				:endif
			:endif
		:endwhile
		:if:<not><storage.get(int,PartyIndex)>=-1
			:if:<not><Pokemon.Level(<storage.get(int,PartyIndex)>)>=<Register.Value(StarterLevelAfterFirstBattle)>
				@Register.Unregister(StarterLevelAfterFirstBattle,int)
				:if:<Pokemon.Level(<storage.get(int,PartyIndex)>)><6			
					@Register.Register(StarterLevelAfterFirstBattle,int,<Pokemon.Level(<storage.get(int,PartyIndex)>)>)
				:else
					@Register.Register(StarterLevelAfterFirstBattle,int,6)
				:endif
			:endif
		:endif
	:else
		@Storage.Set(bool,CheckForStarter,false)
		@Storage.Set(int,PartyIndex,0)
		:while:<storage.get(bool,CheckForStarter)>=false
			:if:<System.Contains(1;2;3;4;5;6;7;8;9,<Pokemon.Number(0)>)>
					@Storage.Set(bool,CheckForStarter,true)
			:else
				:if:<storage.get(int,PartyIndex)><<Pokemon.Count>-1
					@Storage.Set(int,PartyIndex,<storage.get(int,PartyIndex)>+1)
				:else
					@Storage.Set(int,PartyIndex,-1)
					@Storage.Set(bool,CheckForStarter,true)
				:endif
			:endif
		:endwhile
		:if:<not><storage.get(int,PartyIndex)>=-1
			:if:<Pokemon.Level(<storage.get(int,PartyIndex)>)><6			
				@Register.Register(StarterLevelAfterFirstBattle,int,<Pokemon.Level(<storage.get(int,PartyIndex)>)>)
			:else
				@Register.Register(StarterLevelAfterFirstBattle,int,6)
			:endif
		:endif
	:endif
:endif

:end
